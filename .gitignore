# --- Segredos e Variáveis de Ambiente ---
# Arquivos que contém senhas, chaves de API e tokens
.env
.env.*
.zshrc.local

# --- Performance e Compilação ---
# Binários gerados pelo zcompile
*.zwc

# Cache de plugins e autocompletar
.zcompdump*
zsh_plugins_init.zsh

# --- Backup e Temporários ---
# Gerados pelas funções 'sedi', 'bk' e pelo sistema
*.bak
*.bak.*
*.tmp

# --- Logs e Histórico ---
# Evita subir o seu histórico pessoal de comandos
.zsh_history
*.log

# --- IDE e Sistema ---
.vscode/
.DS_Store
Thumbs.db

# --- Graphify Knowledge Graph ---
graphify-out/

# --- Test Dependencies ---
# The harness normally uses the XDG cache, but also ignore a local override.
.test-deps/
